<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Post%20Race%20Screen/Post%20Race%20Screen%20Styles.uss?fileID=7433441132597879392&amp;guid=86baf2b878071614ca86cb869f3cbb73&amp;type=3#Post Race Screen Styles" />
    <engine:VisualElement name="base" class="main-container" style="flex-grow: 1; background-color: rgba(255, 206, 0, 0.56); height: 50px; flex-direction: row; align-items: center; padding-right: 5%; padding-left: 5%; border-top-left-radius: 25px; border-bottom-right-radius: 25px; border-left-color: rgba(0, 0, 0, 0.52); border-right-color: rgba(0, 0, 0, 0.52); border-top-color: rgba(0, 0, 0, 0.52); border-bottom-color: rgba(0, 0, 0, 0.52); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
        <engine:Label text="1st" name="place" class="white" style="-unity-font-style: italic; font-size: 30px; -unity-text-align: upper-left; width: 10%;" />
        <engine:Label text="SomeName123" name="name" class="white" style="-unity-font-style: italic; font-size: 30px;" />
        <engine:VisualElement style="flex-grow: 1;" />
        <engine:Label text="00:00.000" name="time" class="white" style="width: 20%; -unity-text-align: upper-right; font-size: 25px; -unity-font-style: normal;" />
    </engine:VisualElement>
</engine:UXML>
